FROM gcc:9

RUN apt-get update && apt-get install -y \
    make \
    gdb \
    valgrind \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy source code
COPY data/ ./data/
COPY matrix/ ./matrix/
COPY neural/ ./neural/
COPY socket/ ./socket/
COPY util/ ./util/
COPY apps/ ./apps/
COPY Makefile .

# Build worker
RUN make worker

ENTRYPOINT ["./worker"]